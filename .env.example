PORT=3000
NODE_ENV=development

# ─── Required by backend ──────────────────────────────────────────────────────

# Session mode pooler — supports IPv4 + IPv6 (port 5432)
# Dashboard → Connect button → Session mode → copy URI
DATABASE_URL=postgres://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Optional (needed when we add Supabase client server-side) ────────────────

# Dashboard → Settings → API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# New-style secret key (replaces legacy service_role JWT)
# Dashboard → Settings → API Keys → Secret keys tab
# SUPABASE_SECRET_KEY=sb_secret_...

# ─── Frontend reference (NOT used by this backend) ───────────────────────────
# Mobile app uses the publishable key (replaces legacy anon JWT)
# Dashboard → Settings → API Keys → Publishable keys tab
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ─── nomad-agent (Python LangGraph service) ──────────────────────────────────
# Required. The Python service that runs the AI research pipeline.
# Local dev: http://localhost:8001 (uvicorn default per FRONTEND_INTEGRATION_PLAN.md)
# Prod: deployed agent service URL (Render / Cloud Run).
AGENT_SERVICE_URL=http://localhost:8001

# Required. Shared secret for the Node ↔ Python boundary.
# Must byte-match nomad-agent/.env INTERNAL_AGENT_SECRET — mismatch → 401 → trip fails.
# Generate: `openssl rand -hex 32` or any long random string (min 16 chars).
INTERNAL_AGENT_SECRET=change-me-to-a-long-random-string-min-16-chars
