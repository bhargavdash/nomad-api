generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  email       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  trips Trip[]

  @@map("profiles")
}

model Trip {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  destination     String
  dateFrom        String?  @map("date_from")
  dateTo          String?  @map("date_to")
  durationDays    Int?     @map("duration_days")
  travelers       String?
  vibes           String[]
  accommodation   String?
  pace            String?
  budget          String?
  preferences     String?
  status          String   @default("researching")
  statsPlaces     Int      @default(0) @map("stats_places")
  statsTips       Int      @default(0) @map("stats_tips")
  statsPhotoStops Int      @default(0) @map("stats_photo_stops")
  // City-led imagery (resolved server-side from Wikipedia, cached in the DB).
  heroImageUrl     String?   @map("hero_image_url")
  imagesResolvedAt DateTime? @map("images_resolved_at") @db.Timestamptz
  // Trip-level planning surface (Tier 2) — written by the Python agent.
  routeSummary      String?  @map("route_summary")
  transportStrategy String?  @map("transport_strategy")
  seasonalTips      String[] @map("seasonal_tips")
  stayByCity        Json?    @map("stay_by_city")
  budgetEstimate    String?  @map("budget_estimate")
  currencyAdvice    String?  @map("currency_advice")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user        Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  days        ItineraryDay[]
  stops       Stop[]
  researchJob ResearchJob?

  @@map("trips")
}

model ItineraryDay {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  dayNumber   Int      @map("day_number")
  city        String
  title       String
  description String?
  highlights  String[]
  stopCount   Int      @default(0) @map("stop_count")
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stops Stop[]

  @@unique([tripId, dayNumber], name: "trip_day_unique")
  @@map("itinerary_days")
}

model Stop {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dayId       String   @map("day_id") @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  sortOrder   Int      @map("sort_order")
  time        String
  ampm        String
  duration    String
  name        String
  description String?
  source      String
  tags        String[]
  locked      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  day  ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  trip Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("stops")
}

model ResearchJob {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId          String    @unique @map("trip_id") @db.Uuid
  status          String    @default("pending")
  phase           Int       @default(0)
  progress        Int       @default(0)
  message         String?
  statsPlaces     Int       @default(0) @map("stats_places")
  statsTips       Int       @default(0) @map("stats_tips")
  statsPhotoStops Int       @default(0) @map("stats_photo_stops")
  discoveries     Json      @default("[]")
  error           String?
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("research_jobs")
}

// SA-8 (2026-05-30): replaces the old hand-seeded `trending_destinations` and
// the (now-deleted) `insights` table. The agent service writes one row per
// season into `trending_cache`; the Node API reads from here and triggers an
// async refresh when the season key drifts. See nomad-board SA-8 spec.
model TrendingCache {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonKey   String   @unique @map("season_key") // e.g. "winter-2026"
  season      String // "summer" | "monsoon" | "post-monsoon" | "winter"
  year        Int
  payload     Json // TrendingPayload — { india: [...10], international: [...10] }
  refreshedAt DateTime @default(now()) @map("refreshed_at") @db.Timestamptz

  @@map("trending_cache")
}
